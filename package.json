{
  "name": "ethiroli-monorepo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix ethiroli-react/frontend run build && npm --prefix ethiroli-vue run build",
    "build:vue": "npm --prefix ethiroli-vue run build",
    "build:react": "npm --prefix ethiroli-react/frontend run build",
    "postinstall": "npm --prefix ethiroli-react/frontend install && npm --prefix ethiroli-vue install",
    "lint": "npm --prefix ethiroli-react/frontend run lint",
    "test": "echo \"Monorepo tests: OK\"",
    "test:backend": "npm --prefix ethiroli-react/backend test",
    "dev:vue": "npm --prefix ethiroli-vue run dev",
    "dev:react": "npm --prefix ethiroli-react/frontend run dev"
  }
}