PORT=5000
SOCKET_PORT=3003
NODE_ENV=development

FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=ethiroli

SESSION_SECRET=your_session_secret_here_min_32_chars
ENCRYPTION_KEY=your_encryption_key_here_min_32_chars
ENCRYPTION_SECRET=your_encryption_key_here_min_32_chars

SEED_ADMIN_EMAIL=admin@ethiroli.com
SEED_ADMIN_PASSWORD=Admin@123#ChangeMe

LOGIN_RATE_LIMIT_MAX=50
API_RATE_LIMIT_MAX=1000

# === ₹0-First Third-Party Integrations ===
# 1. Workflows: Self-Hosted n8n (Free Community Edition)
N8N_ENABLED=true
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ethiroli
N8N_WEBHOOK_SECRET=ethiroli_n8n_secret_key_2026

# 2. Notifications: Firebase Cloud Messaging (FCM Free Tier)
FCM_SERVER_KEY=
FIREBASE_PROJECT_ID=ethiroli-saas
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 3. Jobs: Indeed Free Organic Syndication & Apply
INDEED_PUBLISHER_KEY=
INDEED_WEBHOOK_SECRET=ethiroli_indeed_secret_2026

# 4. Email: Brevo 300/Day (Free Tier)
EMAIL_PROVIDER=brevo
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_account_email@domain.com
BREVO_SMTP_KEY=xsmtpsib-your-master-smtp-key
BREVO_API_KEY=xkeysib-your-api-key
BREVO_FROM_NAME=Ethiroli SaaS
BREVO_FROM_EMAIL=noreply@ethiroli.com

# === Telemetry Service Configuration === #
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ethiroli-backend
KAFKA_TELEMETRY_TOPIC=lms.telemetry.raw
KAFKA_RETRIES=5
KAFKA_RETRY_BASE_MS=100
KAFKA_RETRY_MAX_MS=10000
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_CONNECTION_TIMEOUT_MS=10000
