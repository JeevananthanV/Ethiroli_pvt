        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Webhook-Secret",
              "value": "ethiroli_n8n_secret_key_2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "trigger_notification"
            },
            {
              "name": "role",
              "value": "SALES"
            },
            {
              "name": "title",
              "value": "New Inbound Sales Lead"
            },
            {
              "name": "body",
              "value": "={{ $json.body.data.name }} sent an inquiry: '{{ $json.body.data.subject }}'"
            }
          ]
        },
        "options": {}
      },
      "id": "3",
      "name": "Notify Sales Team",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [720, 200]
